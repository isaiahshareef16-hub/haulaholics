# ─────────────────────────────────────────────
# Haul-A-Holics — Square Credentials
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# Get these from https://developer.squareup.com/apps
# ─────────────────────────────────────────────

# Your Square Application ID (starts with sq0idp-)
SQUARE_APPLICATION_ID=sq0idp-XXXXXXXXXXXXXXXXXXXXXXXX

# Your Square Access Token (starts with EAA)
# ⚠️  KEEP THIS SECRET — never commit to git or share publicly
SQUARE_ACCESS_TOKEN=EAAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Your Square Location ID
SQUARE_LOCATION_ID=XXXXXXXXXXXXXXX

# Environment: "production" for real cards, "sandbox" for testing
SQUARE_ENVIRONMENT=production

# Server port (default 3000)
PORT=3000
